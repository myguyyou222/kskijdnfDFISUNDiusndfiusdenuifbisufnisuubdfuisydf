# OpenCode Proxy configuration (copy to .env and fill in)

# --- OpenCode server credentials (the runner's basic auth) ---
# These MUST match the OPENCODE_SERVER_PASSWORD repo secret used by the
# workflow. The proxy sends `Authorization: Basic <user>:<pass>` on every
# request to the runner. Without them the runner rejects the connection.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=                # same value as the repo secret

# --- Local proxy ---
OPENCODE_PROXY_HOST=127.0.0.1
OPENCODE_PROXY_PORT=4097
OPENCODE_PROXY_API_KEY=                # optional bearer auth for the proxy itself

# --- Direct OpenCode server URL (e.g. a local `opencode serve`) ---
# Set this to skip Tailscale discovery entirely.
OPENCODE_URL=
OPENCODE_RUNNER_PORT=4096
OPENCODE_WORKSPACE=                    # defaults to process.cwd()
OPENCODE_MODEL=                        # default model id, e.g. anthropic/claude-sonnet-4-5

# --- Tailscale runner discovery (only used when OPENCODE_URL is unset) ---
# TAILSCALE_API_KEY is a tskey-api-... key (NOT the tskey-auth-... OAuth secret).
# TAILSCALE_TAILNET is your tailnet name. If you don't know it, use "-" — the
# API accepts the wildcard when the token is owned by that tailnet.
TAILSCALE_TAILNET=-
TAILSCALE_API_KEY=
OPENCODE_RUNNER_TAG=tag:opencode-runner
OPENCODE_DISCOVERY_TTL_MS=30000
OPENCODE_REQUEST_TIMEOUT_MS=1800000