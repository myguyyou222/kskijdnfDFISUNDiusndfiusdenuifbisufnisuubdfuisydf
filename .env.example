# OpenCode Proxy configuration (copy to .env and fill in)

# Local proxy
OPENCODE_PROXY_HOST=127.0.0.1
OPENCODE_PROXY_PORT=4097
OPENCODE_PROXY_API_KEY=                # optional bearer auth for the proxy itself

# Direct OpenCode server URL (e.g. a local `opencode serve`)
OPENCODE_URL=
OPENCODE_RUNNER_PORT=4096
OPENCODE_WORKSPACE=                    # defaults to process.cwd()
OPENCODE_MODEL=                        # default model id, e.g. anthropic/claude-sonnet-4-5

# Tailscale runner discovery (only used when OPENCODE_URL is unset)
TAILSCALE_TAILNET=
TAILSCALE_API_KEY=
OPENCODE_RUNNER_TAG=tag:opencode-runner
OPENCODE_DISCOVERY_TTL_MS=30000
OPENCODE_REQUEST_TIMEOUT_MS=1800000